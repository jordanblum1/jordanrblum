---
import Base from '../layouts/Base.astro';

// Side-by-side viewer for the three.js renditions. Each tab loads the real
// page with its ?variant query and scrolls the frame to the relevant panel.
const tabs = [
  { id: 'mark-clay', group: 'mark', label: 'mark · clay', src: '/?mark=clay', scroll: 'field', hint: 'Terracotta clay. Hover the panel for a full spin; the strokes bob independently.' },
  { id: 'mark-paper', group: 'mark', label: 'mark · paper', src: '/?mark=paper', scroll: 'field', hint: 'Cut paper — cream faces with ink side walls.' },
  { id: 'mark-sketch', group: 'mark', label: 'mark · sketch', src: '/?mark=sketch', scroll: 'field', hint: 'Ink sketch — ghost fill plus wireframe edges.' },
  { id: 'squish-cloth', group: 'portrait', label: 'portrait · cloth', src: '/?squish=cloth', scroll: 'portrait', hint: 'The whole portrait sways after the cursor like hanging cloth.' },
  { id: 'squish-jelly', group: 'portrait', label: 'portrait · jelly', src: '/?squish=jelly', scroll: 'portrait', hint: 'Move the cursor across the portrait — ripples radiate from it and settle.' },
  { id: 'squish-bulge', group: 'portrait', label: 'portrait · bulge', src: '/?squish=bulge', scroll: 'portrait', hint: 'A lens bulge follows the cursor.' },
  { id: 'fof', group: '404', label: '404 toy', src: '/404', scroll: null, hint: 'Grab a numeral and toss it. Double-click the stage to launch all three.' },
];
---

<Base title="three.js lab — Jordan Blum" description="Internal playground comparing three.js renditions.">
  <main id="main-content" class="lab wide" tabindex="-1">
    <header class="lab-head">
      <div>
        <p class="mono-meta">lab · three.js renditions</p>
        <h1>Pick a rendition.</h1>
      </div>
      <p class="lab-hint" data-lab-hint>{tabs[0].hint}</p>
    </header>

    <div class="lab-tabs" role="tablist" aria-label="three.js renditions">
      {tabs.map((tab, index) => (
        <button
          class="lab-tab"
          role="tab"
          id={`tab-${tab.id}`}
          aria-selected={index === 0 ? 'true' : 'false'}
          data-lab-tab
          data-src={tab.src}
          data-scroll={tab.scroll}
          data-hint={tab.hint}
        >
          {tab.label}
        </button>
      ))}
    </div>

    <div class="lab-frame-wrap">
      <iframe
        class="lab-frame"
        data-lab-frame
        src={tabs[0].src}
        title="Rendition preview"
        loading="eager"
      ></iframe>
    </div>
  </main>
</Base>

<script>
  const frame = document.querySelector<HTMLIFrameElement>('[data-lab-frame]');
  const hint = document.querySelector<HTMLElement>('[data-lab-hint]');
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-lab-tab]')];
  let scrollTarget: string | null = 'field';

  const scrollFrame = () => {
    const doc = frame?.contentDocument;
    if (!doc || !scrollTarget) return;
    const selector = scrollTarget === 'field' ? '.field-panel' : '.portrait-panel';
    const panel = doc.querySelector<HTMLElement>(selector);
    if (panel) {
      const top = panel.getBoundingClientRect().top + (frame.contentWindow?.scrollY ?? 0);
      frame.contentWindow?.scrollTo({ top: Math.max(0, top - 40) });
    }
  };

  frame?.addEventListener('load', () => {
    // Let the page's fonts/layout settle before measuring the scroll target.
    setTimeout(scrollFrame, 120);
  });

  for (const button of buttons) {
    button.addEventListener('click', () => {
      if (!frame) return;
      for (const other of buttons) other.setAttribute('aria-selected', String(other === button));
      scrollTarget = button.dataset.scroll || null;
      if (hint && button.dataset.hint) hint.textContent = button.dataset.hint;
      frame.src = button.dataset.src ?? '/';
    });
  }
</script>

<style>
  .lab {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-8) var(--space-12);
  }

  .lab-head {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-8);
    align-items: end;
    justify-content: space-between;
  }

  .lab-head > div {
    display: grid;
    gap: var(--space-3);
  }

  .lab h1 {
    font-size: clamp(2rem, 3.6vw, 3rem);
    letter-spacing: -0.045em;
  }

  .lab-hint {
    max-width: 38ch;
    color: var(--ink-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .lab-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .lab-tab {
    padding: 0.55rem 0.95rem;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-pill);
    background: var(--paper-raised);
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    cursor: pointer;
    transition:
      border-color var(--duration-default) var(--ease),
      background-color var(--duration-default) var(--ease),
      color var(--duration-default) var(--ease);
  }

  .lab-tab:hover {
    border-color: var(--ink-muted);
  }

  .lab-tab[aria-selected='true'] {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-contrast);
  }

  .lab-frame-wrap {
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-xl);
    background: var(--paper-raised);
  }

  .lab-frame {
    display: block;
    width: 100%;
    height: min(78vh, 56rem);
    border: 0;
  }
</style>
