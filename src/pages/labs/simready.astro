---
import { Image } from 'astro:assets';
import '@fontsource/geist-mono';
import '../../styles/global.css';
import '../../styles/simready.css';
import jrbRed from '../../assets/identity/jrb-logo-red.png';
import HomepagePreview from '../../components/simready/HomepagePreview.astro';
import { concepts, assetUrl, source } from '../../data/simready';
import { social } from '../../data/site';
const email = social.find(link => link.label === 'Email')!;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Three homepage integration previews for Jordan Blum’s personal site." />
    <meta name="color-scheme" content="light" />
    <title>Homepage previews — Jordan Blum</title>
    <link rel="icon" href="/favicon.png" />
  </head>
  <body class="simready-page">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <nav class="preview-nav" aria-label="Primary">
      <a class="preview-wordmark" href="/" aria-label="Jordan Blum — home"><Image src={jrbRed} alt="" width={56} height={56} loading="eager" /></a>
      <a href="/#work">Work</a>
      <a href="/about">About</a>
      <a href={email.href}>Email</a>
    </nav>
    <main id="main-content" class="wide" tabindex="-1" data-simready-lab>
      <div class="preview-switcher">
        <span class="preview-label" id="preview-label">Homepage preview</span>
        <div role="tablist" aria-labelledby="preview-label" aria-orientation="horizontal">
          {concepts.map((concept, i) => <button type="button" role="tab" id={`tab-${concept.id}`} aria-controls={concept.id} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{concept.title}{i === 0 && <span class="recommended"> Recommended</span>}</button>)}
        </div>
      </div>
      {concepts.map((concept, i) => <section role="tabpanel" id={concept.id} aria-labelledby={`tab-${concept.id}`} tabindex="0" hidden={i !== 0}>
        <p class="concept-summary">{concept.description}</p>
        <HomepagePreview concept={concept.id} />
        <div class="load-status" role="status" aria-live="polite" aria-atomic="true"><p data-status>Loading spray can…</p><progress data-progress max="1" aria-label={`${concept.title} spray can loading`}></progress></div>
      </section>)}
      <noscript><p>JavaScript enables the preview switcher and live 3D. The Workbench illustration remains available.</p></noscript>
      <footer class="preview-disclosure">
        <p>Visual preview, not physics simulation. The illustration is an authored fallback; 3D materials may be simplified.</p>
        <p><a href={assetUrl(concepts[0].asset)}>Source spray can</a> · <a href="https://developer.nvidia.com/simready">NVIDIA SimReady</a> via <a href={source}>Hugging Face</a> · <a href="https://creativecommons.org/licenses/by/4.0/">CC-BY-4.0</a>. Presentation modified by Jordan Blum.</p>
      </footer>
    </main>
    <script>
      import { mountLab } from '../../scripts/simready';
      const lab = document.querySelector<HTMLElement>('[data-simready-lab]');
      if (lab) {
        mountLab(lab);
        window.addEventListener('pageshow', event => { if (event.persisted) mountLab(lab); });
      }
    </script>
  </body>
</html>
