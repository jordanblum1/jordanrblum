---
import Base from '../layouts/Base.astro';
---

<Base title="Not found — Jordan Blum" description="This page does not exist.">
  <main id="main-content" class="not-found wide" tabindex="-1">
    <div class="not-found-copy">
      <p class="mono-meta">404 · nothing here</p>
      <h1>This one wandered off.</h1>
      <p>The rest of the site is still where it was.</p>
      <a class="text-link" href="/">Back home <span aria-hidden="true">→</span></a>
    </div>
    <figure class="fof-stage" data-fof-stage aria-hidden="true">
      <span class="fof-fallback">404</span>
      <span class="fof-hint">grab a number · double-tap to toss</span>
    </figure>
  </main>
</Base>

<script src="../scripts/notfound-three.ts"></script>

<style>
  .not-found {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-8);
    align-content: center;
    align-items: center;
    min-height: 72vh;
    padding-block: var(--space-12);
  }

  .not-found-copy {
    grid-column: 1 / span 5;
    display: grid;
    justify-items: start;
    gap: var(--space-6);
  }

  h1 {
    max-width: 12ch;
    font-size: clamp(2.75rem, 5.4vw, 5rem);
    line-height: 0.94;
    letter-spacing: -0.055em;
  }

  .not-found-copy > p:not(.mono-meta) {
    color: var(--ink-muted);
    font-size: 1.1rem;
  }

  .fof-stage {
    position: relative;
    grid-column: 6 / -1;
    min-height: clamp(24rem, 40vw, 32rem);
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--hairline);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(circle at 72% 18%, var(--accent-soft), transparent 44%),
      var(--paper-raised);
  }

  .fof-fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--accent);
    font-family: var(--font-display);
    font-size: clamp(6rem, 12vw, 9rem);
    letter-spacing: -0.04em;
    transition: opacity var(--duration-slow) var(--ease);
  }

  .fof-stage :global(.fof-canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity var(--duration-slow) var(--ease);
  }

  .fof-stage.is-3d :global(.fof-canvas) {
    opacity: 1;
  }

  .fof-stage.is-3d .fof-fallback {
    opacity: 0;
  }

  .fof-hint {
    position: absolute;
    bottom: var(--space-4);
    left: 50%;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%);
    transition: opacity var(--duration-slow) var(--ease);
  }

  .fof-stage.is-3d .fof-hint {
    opacity: 1;
  }

  @media (max-width: 52rem) {
    .not-found {
      grid-template-columns: 1fr;
      align-content: start;
      padding-top: var(--space-8);
    }

    .not-found-copy,
    .fof-stage {
      grid-column: 1;
    }

    .fof-stage {
      min-height: min(24rem, 88vw);
    }
  }
</style>
