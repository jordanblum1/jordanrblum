---
import { Image } from 'astro:assets';
import { iosApps } from '../data/ios-apps';
---

<div class="ios-app-preview">
  {iosApps.map((app, index) => <div class="ios-app-device" style={`--app-index: ${index}`}>
    <Image src={app.image} alt="" widths={[194, 389]} sizes="(max-width: 44rem) 25vw, 15vw" loading="lazy" decoding="async" />
  </div>)}
</div>

<style>
  .ios-app-preview {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: center;
    gap: clamp(8px, 2vw, 20px);
    width: 100%;
    height: 100%;
    padding: 6%;
    background: var(--accent-soft);
  }

  .ios-app-device { min-width: 0; transform: translateY(8px); }
  .ios-app-device:nth-child(2) { transform: translateY(-8px); }
  .ios-app-device :global(img) { display: block; width: 100%; height: auto; }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    :global(.project-link:is(:hover, :focus-visible)) .ios-app-device {
      animation: ios-app-lift 600ms calc(var(--app-index) * 45ms) var(--ease) 1;
    }
  }

  @keyframes ios-app-lift {
    50% { translate: 0 -10px; }
  }
</style>
