---
import type { ConceptId } from '../../data/simready';
interface Props { concept: ConceptId }
const { concept } = Astro.props;
---
<svg class={`study-illustration illustration-${concept}`} viewBox="0 0 1000 620" role="img" aria-label={`${concept === 'dispatch' ? 'Conveyor route drawing' : concept === 'working-set' ? 'Exploded office chair drawing' : 'Coffee cup in window light'} — authored fallback illustration`}>
  {concept === 'dispatch' && <>
    <g class="drawing-grid" fill="none" stroke="currentColor" stroke-width="1">
      <path d="M60 440 610 150 955 335M60 495 610 205 955 390M60 550 610 260 955 445M170 560 170 382M300 545 300 313M430 477 430 245M560 408 560 177M690 340 690 193M820 407 820 263" />
    </g>
    <g class="dispatch-machine" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
      <path d="M230 350 640 160 820 265 410 468Z" fill="var(--paper-raised)"/>
      <path d="M230 350 410 455 820 252 820 293 410 500 230 389Z" fill="var(--paper)"/>
      <path d="M255 392 255 459 283 475 283 410M725 341 725 410 751 395 751 327M409 481 409 549 436 534 436 468" fill="var(--paper)"/>
      {Array.from({length: 15}, (_, i) => <path d={`M${250+i*27} ${344-i*12.5}l160 94`} opacity=".5"/>)}
      <g class="dispatch-parcel" fill="var(--accent-soft)" stroke="var(--accent)">
        <path d="M440 265 512 230 572 265 500 302Z M440 265v65l60 37v-65 M500 367l72-36v-66"/>
        <path d="m473 249 60 36v35" fill="none"/>
      </g>
      <path class="route-line" d="m130 412 75-38m602-138 70-35 68 40m-68-40 15-55" fill="none" stroke="var(--accent)" stroke-dasharray="6 6"/>
    </g>
    <g class="drawing-label" fill="currentColor"><text x="115" y="470">INBOUND</text><text data-route-label x="825" y="160">ROUTE A →</text><text x="615" y="514">TRANSFER / 01</text></g>
  </>}
  {concept === 'working-set' && <>
    <ellipse cx="478" cy="533" rx="188" ry="28" fill="var(--ink)" opacity=".05"/>
    <g class="chair-object" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
      <path d="M480 225v310" fill="none" stroke-dasharray="3 8" opacity=".3"/>
      <g class="chair-back" fill="var(--ink)">
        <path d="M393 136q65-38 131-6l23 124q-59 45-139 17Z"/>
        <path d="m405 148 17 102q57 17 110-3" fill="none" stroke="var(--paper)" opacity=".4"/>
        <path d="m468 276 5 45" fill="none" stroke-width="10"/>
      </g>
      <g class="chair-seat" fill="var(--accent-soft)">
        <path d="m361 339 125-56 127 66-123 68Z"/><path d="M361 339v18l129 72 123-67v-13l-123 68Z"/>
        <path d="m384 342-23-60 35-16m166 78 30-63-31-17" fill="none" stroke-width="8"/>
      </g>
      <g class="chair-base" fill="var(--paper)">
        <path d="M480 411v69" stroke-width="12"/><path d="m480 480-119 29m119-29 124 22m-124-22 3 61m-3-61-66-28m66 28 70-34" stroke-width="8"/>
        <path d="M355 510v14m250-23v14m-121 25v14m-72-102v14m141-20v14" stroke-width="14"/>
      </g>
      <g class="annotation-lines" fill="none" stroke="var(--accent)" stroke-width="1"><path d="M325 158h-95m366 173h138m-150 175h160"/><circle cx="325" cy="158" r="3"/><circle cx="596" cy="331" r="3"/><circle cx="584" cy="506" r="3"/></g>
    </g>
    <g class="drawing-label" fill="var(--accent)"><text x="214" y="146">INPUT</text><text x="655" y="317">ATTENTION</text><text x="671" y="492">REVISION</text></g>
  </>}
  {concept === 'counter-study' && <>
    <path class="window-light" d="M530 55h250L590 565H115Z" fill="var(--accent)" opacity=".07"/>
    <path d="M75 475h850M700 75v375m-85-180h240" fill="none" stroke="currentColor" opacity=".14"/>
    <g class="cup-composition" stroke="currentColor" stroke-width="2">
      <ellipse class="cup-shadow" cx="570" cy="490" rx="202" ry="35" fill="var(--ink)" opacity=".08" stroke="none"/>
      <ellipse cx="472" cy="464" rx="162" ry="43" fill="var(--paper-raised)"/>
      <ellipse cx="472" cy="460" rx="123" ry="27" fill="none" opacity=".3"/>
      <path d="M565 292q100-26 99 50t-104 69l3-27q66 10 66-38t-65-25Z" fill="var(--paper-raised)"/>
      <path d="m366 288 18 136q85 60 168 0l22-136" fill="var(--paper-raised)"/>
      <ellipse cx="470" cy="288" rx="104" ry="32" fill="var(--paper)"/>
      <ellipse cx="470" cy="291" rx="87" ry="22" fill="var(--ink)"/>
      <path d="M402 329l10 75q15 15 35 17" fill="none" opacity=".18" stroke-width="7" stroke-linecap="round"/>
      <path d="M419 221q-25-33 4-59m56 67q-25-33 4-59" fill="none" opacity=".2" stroke-width="1"/>
    </g>
    <g class="drawing-label" fill="currentColor"><text x="147" y="553">LIGHT / STILL LIFE</text><text data-time-label x="716" y="147">08:00</text></g>
  </>}
</svg>
