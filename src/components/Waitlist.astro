---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { supportEmail } from '../data/apps';
interface Props { endpoint: string | null }
const { endpoint } = Astro.props;
const asset = (name: string) => existsSync(join(process.cwd(), 'public/assets/stamp-shift', name)) ? `/assets/stamp-shift/${name}` : undefined;
const collection = asset('collection.webp');
const collectionMotion = asset('collection.mp4');
---
<section aria-labelledby="waitlist-title">
  <div class="launch-invitation">
    <h2 id="waitlist-title">Notify me when it’s available.</h2>
    {collection && <span class="launch-art" aria-hidden="true"><img src={collection} alt="" width="512" height="512" loading="lazy" />{collectionMotion && <video data-landing-motion data-src={collectionMotion} muted loop playsinline preload="none" poster={collection} tabindex="-1"></video>}</span>}
  </div>
  {endpoint ? <>
    <form class="waitlist-form" data-waitlist data-endpoint={endpoint} data-contact={`mailto:${supportEmail}?subject=Stamp%20Shift%20waitlist`}>
      <fieldset disabled>
        <label for="waitlist-email">Email address</label>
        <div class="waitlist-email-row">
          <input id="waitlist-email" name="email" type="email" autocomplete="email" maxlength="254" required />
          <button type="submit">Notify me</button>
        </div>
        <div class="waitlist-trap" aria-hidden="true"><label for="waitlist-website">Website</label><input id="waitlist-website" name="website" tabindex="-1" autocomplete="off" /></div>
      </fieldset>
      <p class="docs-caption">Stamp Shift only. <a href="/apps/stamp-shift/privacy#waitlist">Privacy &amp; removal</a>.</p>
      <p class="waitlist-status" role="status" aria-live="polite" aria-atomic="true"></p>
    </form>
    <noscript><p>To request a launch notification, <a href={`mailto:${supportEmail}?subject=Stamp%20Shift%20launch%20notification`}>Contact support</a>.</p></noscript>
  </> : <p>Launch notifications are not open yet. <a href={`mailto:${supportEmail}?subject=Stamp%20Shift%20launch%20notification`}>Contact support</a>.</p>}
</section>
<script>
  import { setupWaitlist } from '../scripts/waitlist';
  document.querySelectorAll('[data-waitlist]').forEach(setupWaitlist);
</script>
