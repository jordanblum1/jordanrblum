---
import StudioLayout from '../layouts/StudioLayout.astro';
import { studio } from '../../src/data/studio';
---
<StudioLayout title="Contact — Blum Studios" description="Get in touch with Blum Studios." path="/contact">
  <main id="main-content" tabindex="-1" class="studio-contact-redirect">
    <h1>Contact</h1>
    <a href="/#contact">Back to Blum Studios</a>
    <noscript><a href={`mailto:${studio.contactEmail}?subject=Project%20inquiry`}>Email</a></noscript>
  </main>
</StudioLayout>
<script>
  location.replace('/#contact');
</script>
