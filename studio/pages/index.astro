---
import StudioLayout from '../layouts/StudioLayout.astro';
import CityBackdrop from '../components/CityBackdrop.astro';
import blumMark from '../../src/assets/identity/blum-mark.svg?raw';
---
<StudioLayout title="Blum Studios — Apps, design & art" description="Apps, design and art by Jordan Blum. Get in touch." path="/">
  <CityBackdrop />
  <main id="main-content" tabindex="-1" class="studio-home-page">
    <div class="studio-home-content">
      <h1 class="studio-wordmark">
        <span class="studio-blum" aria-hidden="true" set:html={blumMark.replace(/<\?xml[^>]*>/, '')} />
        <span class="studio-sr-only">Blum </span><span class="studio-word">Studios</span>
      </h1>
      <p class="studio-home-line">Apps, design & art.</p>
      <nav class="studio-home-actions" aria-label="Blum Studios">
        <a class="studio-pill studio-pill-primary" href="/contact">
          <svg class="studio-envelope" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path class="studio-envelope-flap" d="m4 7 8 6 8-6" /></svg>
          Contact
        </a>
        <a class="studio-pill" href="https://blumblumblum.com">Links</a>
        <a class="studio-pill" href="/assets/blum-studios/resume.pdf">Resume</a>
      </nav>
    </div>
  </main>
</StudioLayout>
<script>
  if (location.hash === '#contact') location.replace('/contact');
</script>
