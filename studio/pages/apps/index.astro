---
import { Image } from 'astro:assets';
import StudioLayout from '../../layouts/StudioLayout.astro';
import StudioBrand from '../../components/StudioBrand.astro';
import { studio } from '../../../src/data/studio';
import { iosApps } from '../../../src/data/ios-apps';
import { iosAppArt } from '../../../src/data/ios-app-art';
---
<StudioLayout title="iOS apps — Blum Studios" description="Stamp Shift, Alive Still and Birthday. Download an app, get support or read its privacy policy." path="/apps">
  <header class="directory-header directory-width"><StudioBrand /><a class="studio-pill" href="/#contact">Contact</a></header>
  <main id="main-content" tabindex="-1" class="directory-main directory-width">
    <h1>iOS apps</h1>
    <ul class="directory-list" aria-label="Apps">
      {iosApps.map(app => <li>
        <Image src={iosAppArt[app.id]} alt={app.alt} width={194} sizes="72px" />
        <div><h2><a href={`/apps/${app.id}`}>{app.title}</a></h2><p>{app.description}</p>
          <nav aria-label={`${app.title} help`}><a href={app.supportUrl}>Support</a><a href={app.privacyUrl}>Privacy</a></nav>
        </div>
      </li>)}
    </ul>
    <a href={`mailto:${studio.supportEmail}?subject=App%20support`}>Email support</a>
  </main>
  <footer class="directory-footer directory-width"><a href="/work">Work</a><a href="https://jordanblum.com/about">About Jordan</a></footer>
</StudioLayout>
<style>
  .directory-width { width: min(100% - 3rem, 72rem); margin-inline: auto; }
  .directory-header, .directory-footer { display: flex; justify-content: space-between; gap: 1rem; align-items: center; padding-block: 1.5rem; }
  .directory-main { padding-block: 3rem 4rem; }
  .directory-main h1 { font: 600 clamp(2.75rem, 5vw, 4rem)/1.1 Chillax, Switzer, sans-serif; letter-spacing: -.065em; margin-bottom: 2rem; }
  .directory-list { list-style: none; padding: 0; margin: 0 0 2rem; }
  .directory-list li { display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: 2rem; align-items: center; padding-block: 1.5rem; border-top: 1px solid var(--studio-line); }
  .directory-list :global(img) { display: block; width: 100%; height: auto; }
  .directory-list h2 { font: 600 1.6rem/1.2 Chillax, Switzer, sans-serif; letter-spacing: -.04em; }
  .directory-list h2 a { text-decoration: none; }
  .directory-list p { color: var(--studio-muted); margin-block: .5rem !important; }
  .directory-list nav { display: flex; flex-wrap: wrap; gap: 1.5rem; }
  .directory-main a, .directory-footer a { display: inline-flex; min-height: 44px; align-items: center; }
  .directory-footer { border-top: 1px solid var(--studio-line); }
  @media(max-width: 500px) { .directory-list li { grid-template-columns: 72px minmax(0, 1fr); gap: 1rem; } .directory-header, .directory-footer { flex-wrap: wrap; } }
</style>
