---
import '../styles/studio.css';
import { studio } from '../../src/data/studio';
import switzer from '../../src/assets/fonts/switzer-400.woff2?url';
import chillax from '../../src/assets/fonts/chillax-600.woff2?url';

interface Props {
  title: string;
  description: string;
  path?: string;
}
const { title, description, path = Astro.url.pathname } = Astro.props;
const canonical = new URL(path, studio.origin);
const socialImage = new URL('/assets/blum-studios/studio-og-v2.jpg', studio.origin);
const socialVideo = path === '/' ? new URL('/assets/blum-studios/studio-og-v2.mp4', studio.origin) : null;
const socialTitle = path === '/' ? 'iOS apps & web products' : title;
const socialDescription = path === '/' ? 'Independent product design and development. From idea to launch with Blum Studios.' : description;
const socialAlt = 'Blum Studios with a genuine iPhone app, web project and illustrated New York backdrop.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#F7F3ED" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={studio.name} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={socialDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialAlt} />
    {socialVideo && <>
      <meta property="og:video" content={socialVideo} />
      <meta property="og:video:secure_url" content={socialVideo} />
      <meta property="og:video:type" content="video/mp4" />
      <meta property="og:video:width" content="1200" />
      <meta property="og:video:height" content="630" />
    </>}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={socialDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialAlt} />
    <link rel="icon" type="image/svg+xml" href="/assets/blum-studios/favicon.svg" />
    <link rel="preload" href={switzer} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={chillax} as="font" type="font/woff2" crossorigin />
  </head>
  <body class="studio-site">
    <a class="studio-skip" href="#main-content">Skip to content</a>
    <slot />
  </body>
</html>
