<button class="city-motion-toggle" type="button" data-city-motion-toggle aria-label="Pause city animation" title="Pause city animation" hidden>
    <svg class="city-pause-icon" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="M6.5 4.5v11m7-11v11" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
    <svg class="city-play-icon" viewBox="0 0 20 20" width="16" height="16" aria-hidden="true"><path d="m7 4 9 6-9 6Z" fill="currentColor" /></svg>
</button>
<script>
  const background = document.querySelector<HTMLElement>('[data-city-background]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-city-motion-toggle]');
  if (background && toggle) {
    const preference = matchMedia('(prefers-reduced-motion: reduce)');
    let paused = false;
    const update = () => {
      background.dataset.paused = String(paused);
      toggle.dataset.paused = String(paused);
      toggle.hidden = preference.matches;
      const label = paused ? 'Play city animation' : 'Pause city animation';
      toggle.setAttribute('aria-label', label);
      toggle.title = label;
    };
    toggle.addEventListener('click', () => { paused = !paused; update(); });
    preference.addEventListener('change', update);
    background.dataset.motionEnabled = 'true';
    update();
  }
</script>
